---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Slotavio',
    desc: 'Booking platform for Black &amp; Afro hair professionals. Solo-built full stack &mdash; Next.js, Node.js, PostgreSQL, payments.',
    href: 'https://slotavio.com',
  },
  {
    name: 'PrayGuard',
    desc: 'Screen Time app blocker built on Apple’s Family Controls API with custom Swift modules.',
    href: 'https://apps.apple.com/us/app/id6757086543',
  },
  {
    name: 'SubHelm',
    desc: 'Subscription tracker with renewal reminders so nothing bills you by surprise.',
    href: 'https://apps.apple.com/us/app/subhelm-subscription-tracker/id6777939621',
  },
  {
    name: 'Scribe Scan',
    desc: 'Handwriting OCR &mdash; snap a photo of handwritten notes and get editable text back.',
    href: 'https://apps.apple.com/us/app/scribe-scan-handwriting-ocr/id6758213865',
  },
];
---

<Layout
  title="Projects — Sambulo Senda"
  description="Apps and platforms I've built — Slotavio, PrayGuard, SubHelm, Scribe Scan, and more on the App Store."
>
  <div class="page">
    <div class="page-head">
      <h1 class="page-title">Projects</h1>
      <span class="page-meta">SHIPPED</span>
    </div>

    <p class="now-intro">Things I've built &mdash; mostly solo, mostly shipped.</p>

    <div class="proj-list">
      {projects.map((p) => (
        <a class="proj-row" href={p.href} target="_blank" rel="noopener noreferrer">
          <span class="proj-name">{p.name}<span class="proj-arrow">&#8599;</span></span>
          <p class="proj-desc" set:html={p.desc} />
        </a>
      ))}
    </div>

    <p class="now-note">
      More on the <a class="clink" href="https://apps.apple.com/us/developer/sambulo-senda/id957217460" target="_blank" rel="noopener noreferrer">App Store &#8599;</a>
    </p>
  </div>
</Layout>

<style>
  .proj-list { margin-top: 6px; }
  .proj-row {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 18px 0;
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
  }
  .proj-name {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16.5px;
    color: var(--fg);
    transition: color .15s ease;
  }
  .proj-row:hover .proj-name { color: var(--accent); }
  .proj-arrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity .18s ease, transform .18s ease, color .18s ease;
  }
  .proj-row:hover .proj-arrow { opacity: 1; transform: translateX(0); color: var(--accent); }
  .proj-desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.55;
    color: var(--body);
    margin: 0;
  }
</style>
